{
  "name": "mcp-google-merchants",
  "version": "1.2.0",
  "description": "MCP server for Google Merchant Center (Merchant API v1) — products, data sources, promotions, MCQL reports, price competitiveness and product issues for AI agents. OAuth with write support.",
  "mcpName": "io.github.A1-x-Tech/mcp-google-merchants",
  "type": "module",
  "bin": {
    "mcp-google-merchants": "dist/index.js"
  },
  "files": [
    "dist",
    "test"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "smoke": "node --import tsx src/smoke.ts",
    "test": "npm run test:src && npm run test:dist",
    "test:src": "node --import tsx --test $(find src -name '*.test.ts')",
    "test:dist": "npm run build && node --test test/dist-smoke.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "deploy:cloudflare": "wrangler deploy",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google",
    "merchant-center",
    "merchant-api",
    "google-shopping",
    "e-commerce",
    "mcql",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "author": "gistrec <gistrec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A1-x-Tech/mcp-google-merchants.git"
  },
  "homepage": "https://github.com/A1-x-Tech/mcp-google-merchants#readme",
  "bugs": {
    "url": "https://github.com/A1-x-Tech/mcp-google-merchants/issues"
  },
  "dependencies": {
    "@a1-x-tech/mcp-google-auth": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0",
    "@cloudflare/workers-oauth-provider": "^0.0.5",
    "agents": "^0.0.95",
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "wrangler": "^4.20.1",
    "@cloudflare/workers-types": "^5.20261019.1"
  }
}
