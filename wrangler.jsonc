{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paintarthub-gmc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "MCP_OBJECT", "class_name": "MerchantMCP" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MerchantMCP"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d59f4891f2ae43beb1a701ed3ab54319" }],
  "vars": { "GMC_WRITES_ENABLED": "false" },
  "observability": { "enabled": true }
}
